# Copy to .env.local for local development.

# Set to "true" to wire the web app to the live ValEstate API (requires the
# backend running — `make up` — at NEXT_PUBLIC_API_BASE_URL). When unset/false,
# the app runs entirely on mock data (auth is a local demo), so the static
# Vercel deploy keeps working with no backend.
NEXT_PUBLIC_USE_API=false

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/v1

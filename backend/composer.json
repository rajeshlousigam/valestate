{
    "name": "housepoint/backend",
    "description": "ValEstate REST API — verification-first real-estate marketplace",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-openssl": "*",
        "yiisoft/yii2": "~2.0.49",
        "yiisoft/yii2-redis": "~2.0.18"
    },
    "require-dev": {
        "yiisoft/yii2-debug": "~2.1.0",
        "phpunit/phpunit": "^10.5"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "autoload": {
        "psr-4": {
            "app\\": ""
        }
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}

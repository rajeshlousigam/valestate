# ---- ValEstate local env (copy to .env; NEVER commit .env) ----

# Launch-city config (docs/24)
APP_ENV=dev
DEFAULT_CITY=imphal
DEFAULT_COUNTRY=IN
DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en-IN
DEFAULT_TIMEZONE=Asia/Kolkata
AWS_REGION=ap-south-1

# Feature flags (docs/24 §8)
FEATURE_BROKER_ROLE=false
FEATURE_MAP_SEARCH=false
FEATURE_IN_APP_CHAT=true
FEATURE_APPEALS=false

# Database (MySQL 8)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=housepoint
DB_USER=housepoint
DB_PASSWORD=change_me_local
DB_ROOT_PASSWORD=change_me_root

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Yii2
YII_DEBUG=1
YII_ENV=dev
COOKIE_VALIDATION_KEY=change_me_cookie_key

# Auth (docs/10) — Phase 0 seed uses HS256; swap to RS256 keypair before prod.
# JWT is implemented natively (no third-party lib) in services/JwtService.php.
JWT_ALG=HS256
JWT_SECRET=change_me_jwt_secret_min_32_chars_long
ACCESS_TOKEN_TTL=900          # 15 min
REFRESH_TOKEN_TTL=2592000     # 30 days
# For RS256 (prod): set JWT_ALG=RS256 and provide a PEM keypair (multi-line via secrets manager).
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# Verification SLA / retention (docs/24)
SLA_CLAIM_HOURS=4
SLA_DECIDE_HOURS=24
DOC_RETENTION_DAYS=90

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/v1

# CORS: comma-separated web origins allowed to call the API
WEB_ORIGIN=http://localhost:3000
